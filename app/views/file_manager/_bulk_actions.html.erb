<%# locals: (folders:, can_write:, can_delete:) %>
<%# Moving or deleting the ticked files. The tiles' and rows' checkboxes join
    this form with form="assets_bulk". In the grid it shows only in Bulk
    select (.media-bulk-actions, media/file-manager.css, which sets its display). %>
<%= form_with url: can_write ? file_manager_moves_path : file_manager_bulk_deletions_path, id: "assets_bulk",
      class: "media-bulk-actions" do %>
  <% if can_write %>
    <label class="cluster">
      <span class="text-body">Move the ticked files to</span>
      <%= select_tag :to, options_for_select([["All files (top level)", "/"]] + folders.map { [it, it] }), id: nil %>
    </label>
    <button type="submit" class="btn btn--sm" formaction="<%= file_manager_moves_path %>">Move</button>
  <% end %>
  <% if can_delete %>
    <div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-action="keydown.esc->dialog#close:stop">
      <button type="button" class="btn btn--danger btn--sm push-end" data-action="dialog#open">
        <%= icon_tag "trash" %>
        <span>Delete ticked</span>
      </button>
      <dialog class="dialog dialog--action" data-dialog-target="dialog">
        <h3 class="heading heading--lg">Delete the ticked files?</h3>
        <p class="text-body">They go to the trash, where they can be restored.</p>
        <div class="dialog__actions">
          <button type="button" class="btn" data-action="dialog#close">Cancel</button>
          <button type="submit" class="btn btn--destructive" formaction="<%= file_manager_bulk_deletions_path %>">
            <%= icon_tag "trash" %>
            <span>Delete</span>
          </button>
        </div>
      </dialog>
    </div>
  <% end %>
<% end %>
