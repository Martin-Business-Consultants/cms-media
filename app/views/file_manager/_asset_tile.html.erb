<%# locals: (asset:, selectable:) %>
<%# One file in the library's grid, as Payload shows it: a square of the
    picture (or, for any other file, its icon), its name and what it is
    under it. Picking it opens its details in the library's sheet; in Bulk
    select, the whole tile is its tick (media/file-manager.css). %>
<div id="<%= dom_id(asset) %>" class="media-tile" data-filter-target="item">
  <%= link_to file_manager_asset_path(asset), class: "media-tile__link", title: asset.title,
        data: { turbo_frame: "asset_details", action: "dialog#open" } do %>
    <span class="media-thumb media-thumb--square">
      <%= asset_thumbnail asset, size: 320 %>
    </span>
    <span class="media-tile__text">
      <span class="media-tile__name truncate"><%= asset.title %></span>
      <span class="media-tile__meta truncate"><%= asset_meta(asset) %></span>
    </span>
  <% end %>
  <% if selectable %>
    <label class="media-tile__select">
      <input type="checkbox" name="ids[]" value="<%= asset.id %>" form="assets_bulk">
      <span class="visually-hidden">Select <%= asset.title %></span>
    </label>
  <% end %>
</div>
