<%# locals: (asset:, folders:) %>
<%# A file's details, as WordPress's Attachment details: the picture, what
    the file is, its title, alt text, caption, description and folder, and
    where the site uses it. In the library's sheet (the asset_details frame)
    and on the file's own page. %>
<% can_write = Current.user.can?("assets:write") %>
<% usages = asset.referencing_records %>
<div class="stack stack--lg">
  <% if flash[:notice].present? && turbo_frame_request? %>
    <p class="notice notice--success"><%= flash[:notice] %></p>
  <% end %>

  <div class="media-details__preview">
    <% if asset.image? %>
      <%= image_tag(asset.variantable? && ApplicationHelper.variants_supported? ? asset.thumb_url(1024) : asset.url, alt: asset.alt.to_s) %>
    <% else %>
      <%= icon_tag "attachment", class: "icon--xl" %>
    <% end %>
  </div>

  <dl class="details">
    <dt>Uploaded</dt><dd><%= time_ago_tag asset.created_at %></dd>
    <dt>File name</dt><dd class="text-mono text-small"><%= asset.filename %></dd>
    <dt>File type</dt><dd><%= asset.content_type %></dd>
    <dt>File size</dt><dd><%= number_to_human_size(asset.byte_size) %></dd>
    <% if asset.file.metadata["width"] %>
      <dt>Dimensions</dt><dd><%= asset.file.metadata["width"] %> × <%= asset.file.metadata["height"] %> pixels</dd>
    <% end %>
  </dl>

  <div class="cluster">
    <button type="button" class="btn btn--sm" data-controller="copy-to-clipboard" data-copy-to-clipboard-content-value="<%= asset.url %>"
      data-copy-to-clipboard-success-class="btn--success" data-action="copy-to-clipboard#copy">
      <%= icon_tag "copy-paste" %>
      <span>Copy URL</span>
    </button>
    <%= link_to rails_blob_path(asset.file, disposition: "attachment"), class: "btn btn--sm", data: { turbo: false } do %>
      <span>Download</span>
    <% end %>
    <% if Current.user.can?("assets:delete") %>
      <%= render "layouts/shared/delete_dialog", name: asset.title, path: file_manager_asset_path(asset),
            message: "It goes to the trash, where it can be restored.", trigger_text: "Move to trash", trigger_class: "push-end" %>
    <% end %>
  </div>

  <%= render "layouts/shared/errors", record: asset %>
  <%= form_with model: asset, url: file_manager_asset_path(asset), scope: :asset do |form| %>
    <%= tag.fieldset class: "fields", disabled: !can_write do %>
      <label class="field">
        <span class="label">Alternative text</span>
        <%= form.text_area :alt, rows: 2, placeholder: "What the image shows, for people who can’t see it." %>
        <span class="help">Read aloud by screen readers, and shown when the image can’t load. Leave it empty if the image is purely decorative.</span>
      </label>
      <label class="field">
        <span class="label">Title</span>
        <%= form.text_field :name, placeholder: asset.filename, autocomplete: "off" %>
      </label>
      <label class="field">
        <span class="label">Caption</span>
        <%= form.text_area :caption, rows: 2 %>
        <span class="help">Shown with it on the site, where the site shows captions.</span>
      </label>
      <label class="field">
        <span class="label">Description</span>
        <%= form.text_area :description, rows: 3 %>
      </label>
      <label class="field">
        <span class="label">Folder</span>
        <%= form.select :folder, options_for_select([["Top level", "/"]] + folders.map { [it, it] }, asset.folder) %>
      </label>
      <% if can_write %>
        <div>
          <%= form.button "Save", class: "btn btn--primary" %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <section class="media-section">
    <h3 class="heading">Used in</h3>
    <% if usages.any? %>
      <ul class="stack stack--xs">
        <% usages.each do |record| %>
          <%# herb:key record.class.name + record.id.to_s %>
          <li>
            <%= link_to record.try(:title).presence || record.try(:slug) || record.class.name, admin_record_path(record), class: "link", data: { turbo_frame: "_top" } %>
            <span class="text-muted"><%= record.class.model_name.human %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-muted">Nothing on the site uses it yet.</p>
    <% end %>
  </section>
</div>
