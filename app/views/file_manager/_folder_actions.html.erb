<%# locals: (folder:, can_delete:) %>
<%# Making a folder inside this one; renaming or deleting this one. An open
    form takes the row's whole width (.file-manager__inline-form). %>
<div class="cluster">
  <details class="file-manager__inline-form">
    <summary class="btn">
      <%= icon_tag "add" %>
      <span>New folder</span>
    </summary>
    <%= form_with url: file_manager_folder_path, class: "row", namespace: "new_folder" do |form| %>
      <%= form.hidden_field :parent, value: folder %>
      <%= form.text_field :name, required: true, placeholder: "e.g. Logos", autocomplete: "off", aria: { label: "Folder name" } %>
      <button type="submit" class="btn">Create</button>
    <% end %>
  </details>

  <% if folder != "/" %>
    <details class="file-manager__inline-form">
      <summary class="btn">
        <%= icon_tag "pencil" %>
        <span>Rename folder</span>
      </summary>
      <%= form_with url: file_manager_folder_path, method: :patch, class: "row", namespace: "rename_folder" do |form| %>
        <%= form.hidden_field :path, value: folder %>
        <%= form.text_field :name, value: AssetFolders.name(folder), required: true, autocomplete: "off", aria: { label: "New name" } %>
        <button type="submit" class="btn">Rename</button>
      <% end %>
    </details>
    <% if can_delete %>
      <%= render "layouts/shared/delete_dialog", name: "folder " + AssetFolders.name(folder),
            path: file_manager_folder_path(path: folder),
            message: "Every file in it, and in the folders inside it, goes to the trash." %>
    <% end %>
  <% end %>
</div>
